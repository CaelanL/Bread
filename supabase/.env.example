# Supabase Edge Function Secrets
# Copy to functions/.env for local development
# Deploy to production with: supabase secrets set --env-file functions/.env

# Bible APIs
ESV_API_KEY=your_esv_api_key
API_BIBLE_KEY=your_api_bible_key

# Speech-to-text
SONIOX_API_KEY=your_soniox_api_key

# LLM for transcription cleaning
OPENAI_API_KEY=sk-proj-...
