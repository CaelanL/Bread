{
  "name": "biblemem",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/db.mjs guard && expo start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\" \"tests/*.test.mjs\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "clean-kjv": "node ./scripts/clean-kjv.js",
    "postinstall": "patch-package",
    "check:fast": "npm run typecheck && npm run lint && npm test && node scripts/check-migrations.mjs && node scripts/check-repo.mjs",
    "check": "npm run check:fast && npm run db:reset && npm run test:db && npm run db:types -- --check",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:reset": "node scripts/db.mjs reset",
    "db:env": "node scripts/db.mjs env",
    "db:status": "node scripts/db.mjs status",
    "db:types": "node scripts/db.mjs types",
    "db:destroy": "node scripts/db.mjs destroy",
    "test:db": "supabase test db",
    "doctor": "node scripts/doctor.mjs",
    "release": "node scripts/release.mjs",
    "sim": "node scripts/sim.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@siteed/audio-studio": "3.2.0",
    "@supabase/supabase-js": "^2.88.0",
    "diff": "^8.0.2",
    "expo": "~57.0.33",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.24",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.31",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.28",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "squawk-cli": "2.70.0",
    "supabase": "3.1.0",
    "tsx": "4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true,
  "kit": {
    "prodProjectRef": "bhvvagvnmoxpjgfffgpl",
    "restoredMigrations": [
      "010_add_word_count.sql",
      "0101_popular_verses.sql",
      "011_user_stats_cron.sql",
      "012_analytics_functions.sql"
    ],
    "envFile": ".env.local",
    "envNames": {
      "API_URL": "EXPO_PUBLIC_SUPABASE_URL",
      "ANON_KEY": "EXPO_PUBLIC_SUPABASE_ANON_KEY"
    },
    "libDirs": [
      "lib"
    ],
    "docsStrict": true,
    "deployFunctions": true,
    "deploy": {
      "type": "eas-workflow",
      "workflow": "deploy.yml"
    },
    "sim": {
      "name": "bread",
      "scheme": "com.biblemem"
    }
  }
