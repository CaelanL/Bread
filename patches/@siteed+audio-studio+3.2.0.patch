+/// Bread: carries input audio from the sink node's realtime IO thread to a processing
+/// thread. The IO side only copies into preallocated slots and signals a semaphore: no
+/// locks, no allocation, no Objective-C calls. If processing falls a full ring behind,
+/// the IO side drops the cycle rather than wait.
+final class BreadInputRing {
+    let format: AVAudioFormat
+    private static let slotCount = 64
+    private static let slotFrames: AVAudioFrameCount = 4096
+    private let slots: [AVAudioPCMBuffer]
+    private let slotLists: [UnsafeMutableAudioBufferListPointer]
+    private let slotFrameCounts = UnsafeMutablePointer<AVAudioFrameCount>.allocate(capacity: BreadInputRing.slotCount)
+    // [0] slots written (IO thread only), [1] slots read (processing thread only)
+    private let counts = UnsafeMutablePointer<Int>.allocate(capacity: 2)
+    private let closed = UnsafeMutablePointer<Bool>.allocate(capacity: 1)
+    private let bytesPerFrame: Int
+    private let ready = DispatchSemaphore(value: 0)
+
+    init?(format: AVAudioFormat, process: @escaping (AVAudioPCMBuffer) -> Void) {
+        var buffers: [AVAudioPCMBuffer] = []
+        for _ in 0..<BreadInputRing.slotCount {
+            guard let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: BreadInputRing.slotFrames) else { return nil }
+            buffers.append(buffer)
+        }
+        self.format = format
+        slots = buffers
+        slotLists = buffers.map { UnsafeMutableAudioBufferListPointer($0.mutableAudioBufferList) }
+        bytesPerFrame = Int(format.streamDescription.pointee.mBytesPerFrame)
+        counts.initialize(repeating: 0, count: 2)
+        closed.initialize(to: false)
+        slotFrameCounts.initialize(repeating: 0, count: BreadInputRing.slotCount)
+        let thread = Thread { [self] in self.drain(process) }
+        thread.name = "Bread input"
+        thread.qualityOfService = .userInteractive
+        thread.start()
+    }
+
+    deinit {
+        slotFrameCounts.deallocate()
+        counts.deallocate()
+        closed.deallocate()
+    }
+
+    /// IO thread only.
+    func push(_ input: UnsafePointer<AudioBufferList>, frameCount: AVAudioFrameCount) {
+        let source = UnsafeMutableAudioBufferListPointer(UnsafeMutablePointer(mutating: input))
+        var offset: AVAudioFrameCount = 0
+        while offset < frameCount {
+            let written = counts[0]
+            if written - counts[1] >= BreadInputRing.slotCount { return }
+            let slot = written % BreadInputRing.slotCount
+            let frames = min(frameCount - offset, BreadInputRing.slotFrames)
+            let target = slotLists[slot]
+            for i in 0..<min(source.count, target.count) {
+                guard let from = source[i].mData, let to = target[i].mData else { continue }
+                memcpy(to, from + Int(offset) * bytesPerFrame, Int(frames) * bytesPerFrame)
+            }
+            slotFrameCounts[slot] = frames
+            counts[0] = written + 1
+            ready.signal()
+            offset += frames
+        }
+    }
+
+    func close() {
+        closed.pointee = true
+        ready.signal()
+    }
+
+    private func drain(_ process: (AVAudioPCMBuffer) -> Void) {
+        while true {
+            ready.wait()
+            if closed.pointee { return }
+            let read = counts[1]
+            let slot = read % BreadInputRing.slotCount
+            let buffer = slots[slot]
+            buffer.frameLength = slotFrameCounts[slot]
+            process(buffer)
+            counts[1] = read + 1
+        }
+    }
+}
