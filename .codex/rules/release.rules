R = "Merge and migrate prod only with npm run release."
prefix_rule(pattern=["gh", "pr", "merge"], decision="forbidden", justification=R)
prefix_rule(pattern=["git", "push", "origin", ["main", "HEAD:main"]], decision="forbidden", justification=R)
prefix_rule(pattern=["git", "push", ["-u", "--set-upstream"], "origin", ["main", "HEAD:main"]], decision="forbidden", justification=R)
prefix_rule(pattern=["git", "push", ["--force", "-f", "--force-with-lease"]], decision="forbidden", justification=R)
prefix_rule(pattern=[["supabase", "./node_modules/.bin/supabase", "node_modules/.bin/supabase"], "db", "push"], decision="forbidden", justification=R)
prefix_rule(pattern=[["supabase", "./node_modules/.bin/supabase", "node_modules/.bin/supabase"], "db", ["reset", "query"], "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=[["supabase", "./node_modules/.bin/supabase", "node_modules/.bin/supabase"], "migration", "up", "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=[["supabase", "./node_modules/.bin/supabase", "node_modules/.bin/supabase"], "migration", "repair"], decision="forbidden", justification=R)
prefix_rule(pattern=["npx", "supabase", "db", "push"], decision="forbidden", justification=R)
prefix_rule(pattern=["npx", "supabase", "db", ["reset", "query"], "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=["npx", "supabase", "migration", "up", "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=["npx", "supabase", "migration", "repair"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "supabase", "db", "push"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "supabase", "db", ["reset", "query"], "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "supabase", "migration", "up", "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "supabase", "migration", "repair"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "--", "supabase", "db", "push"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "--", "supabase", "db", ["reset", "query"], "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "--", "supabase", "migration", "up", "--linked"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "exec", "--", "supabase", "migration", "repair"], decision="forbidden", justification=R)
prefix_rule(pattern=["npm", "run", "release"], decision="allow", justification="The one path to prod.")
